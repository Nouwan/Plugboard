// <auto-generated/>
#nullable enable

using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Routing;

namespace {{ root_namespace }};

internal static class EndpointRegistrationExtensions
{
    /// <summary>Maps every endpoint and endpoint group declared in this assembly.</summary>
    internal static IEndpointRouteBuilder RegisterEndpoints(this IEndpointRouteBuilder app)
    {
        {{- for ep in endpoints }}
        {{ ep }}.MapEndpoint(app);
        {{- end }}
        {{- for group in groups }}
        app.Register{{ group.name }}();
        {{- end }}
        return app;
    }
    {{~ for group in groups ~}}

    /// <summary>Maps <see cref="{{ group.fqn }}"/> and the endpoints declared for it.</summary>
    internal static IEndpointRouteBuilder Register{{ group.name }}(this IEndpointRouteBuilder app)
    {
        RouteGroupBuilder group = app.MapGroup(string.Empty);
        {{ group.fqn }}.Configure(group);
        {{- for ep in group.endpoints }}
        {{ ep }}.MapEndpoint(group);
        {{- end }}
        return app;
    }
    {{~ end ~}}
}