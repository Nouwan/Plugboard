<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>Plugboard</RootNamespace>
        <PackageId>Plugboard</PackageId>
        <Description>Plugboard</Description>
        <PackageTags>aspnetcore;minimal-api;endpoints;source-generator;analyzer</PackageTags>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DevelopmentDependency>false</DevelopmentDependency>
    </PropertyGroup>

    <ItemGroup>
        <!-- Build ordering only; the generator + analyzer assembly ships inside this package under analyzers/dotnet/cs. -->
        <ProjectReference Include="..\Plugboard.Generator\Plugboard.Generator.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\Plugboard.Generator\bin\$(Configuration)\netstandard2.0\Plugboard.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

</Project>
