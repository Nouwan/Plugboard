// <auto-generated/>
#nullable enable

using Microsoft.AspNetCore.Routing;

namespace {{ root_namespace }};

internal static class EndpointRegistrationExtensions
{
    extension(IEndpointRouteBuilder app)
    {
        /// <summary>Maps every endpoint and endpoint group declared in this assembly.</summary>
        internal IEndpointRouteBuilder MapEndpoints()
        {
            {{- for ep in endpoints }}
            {{ ep }}(app);
            {{- end }}
            {{- for group in groups }}
            app.Map{{ group.name }}();
            {{- end }}
            return app;
        }
        {{~ for group in groups ~}}

        /// <summary>Maps <see cref="{{ group.type }}"/> and the endpoints declared for it.</summary>
        internal IEndpointRouteBuilder Map{{ group.name }}()
        {
            IEndpointRouteBuilder group = {{ group.type }}.CreateGroup(app);
            {{- for ep in group.endpoints }}
            {{ ep }}(group);
            {{- end }}
            return app;
        }
        {{~ end ~}}
    }
}