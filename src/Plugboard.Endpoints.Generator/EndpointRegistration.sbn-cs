// <auto-generated/>
#nullable enable

using Microsoft.AspNetCore.Routing;

namespace {{ root_namespace }};

internal static class EndpointRegistrationExtensions
{
    extension(IEndpointRouteBuilder app)
    {
        /// <summary>Maps every endpoint and endpoint group declared in this assembly.</summary>
        internal IEndpointRouteBuilder RegisterEndpoints()
        {
            {{- for ep in endpoints }}
            {{ ep }}.MapEndpoint(app);
            {{- end }}
            {{- for group in groups }}
            app.Register{{ group.name }}();
            {{- end }}
            return app;
        }
        {{~ for group in groups ~}}

        /// <summary>Maps <see cref="{{ group.fqn }}"/> and the endpoints declared for it.</summary>
        internal IEndpointRouteBuilder Register{{ group.name }}()
        {
            RouteGroupBuilder group = {{ group.fqn }}.MapEndpointGroup(app);
            {{- for ep in group.endpoints }}
            {{ ep }}.MapEndpoint(group);
            {{- end }}
            return app;
        }
        {{~ end ~}}
    }
}