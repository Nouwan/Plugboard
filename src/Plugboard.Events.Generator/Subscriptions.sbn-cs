// <auto-generated/>
#nullable enable

using Microsoft.Extensions.DependencyInjection;
using Plugboard.Events;

namespace {{ root_namespace }};

public static class {{ module }}EventsExtensions
{
    extension(IServiceCollection services)
    {
        /// <summary>Registers every IEventContext and subscribes every handler declared in this assembly.</summary>
        public IServiceCollection Add{{ module }}Events()
        {
            {{- for context in event_contexts }}
            services.AddEventContext<{{ context }}>();
            {{- end }}
            return services.AddSubscriptions(static events =>
            {
                {{- for method in subscribe_methods }}
                {{ method }}(events);
                {{- end }}
            });
        }
    }
}